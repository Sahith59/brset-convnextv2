# Patient-image symlinks and any locally materialized data (full BRSET is a
# credentialed PhysioNet dataset; only aggregate results are shared here,
# never the underlying images or per-patient label files).
data/

# Trained model weights (large binaries; also not appropriate to redistribute
# since they were trained on credentialed data).
results/**/*.pth

# Per-patient derived label/split manifests (patient_id + diagnosis grade).
results/splits*.csv
results/corrupted_files*.txt

# Raw per-image ground-truth labels + model outputs (even without patient IDs
# attached, these are still per-image diagnostic ground truth derived from
# the credentialed datasets). Covers every cached prediction/teacher-probability
# array anywhere under results/, not just the original test_predictions.npz name.
results/**/*.npz

# Raw SLURM stdout/stderr job logs (operational noise, not results).
logs/

# Misc
__pycache__/
*.pyc
.ipynb_checkpoints/

# Personal reference notes (code snippets + config for talking through the
# model) - useful locally, not repo content.
presentation/model_reference.md
presentation/speaker_notes.md

# Ad-hoc screenshots pasted in while reviewing slides (not repo content).
Screenshot*.png
presentation/Screenshot*.png

# Personal meeting aids, not repo content.
presentation/findings_speaker_notes.md
presentation/cluely_context_prompt.md

# Codex research workspace: keep reproducible code, protocols, aggregate
# summaries, and decision records in Git. Keep credentialed data derivatives,
# patient-level manifests, model states, generated image-bearing reports,
# scratch predictions, raw logs, and machine-local symlinks private.
research/codex/**/__pycache__/
research/codex/**/*.pyc
research/codex/**/*.pth
research/codex/**/*.npz
research/codex/**/*.out
research/codex/**/*.err
research/codex/**/*.log
research/codex/**/logs/
research/codex/**/runs
research/codex/**/initializations
research/codex/**/smoke_full
research/codex/**/smoke_resume
research/codex/**/phase_smoke_full
research/codex/**/phase_smoke_resume
research/codex/step3/smoke/
research/codex/**/*private*.csv
research/codex/protocol/development_manifest_v1.csv
research/codex/step2/full_pool/protocol/full_pool_manifest.csv
research/codex/updates/**/*.png
research/codex/updates/**/*.pdf
research/codex/updates/**/*.docx
research/codex/updates/**/figure_provenance.json

# Figures containing actual BRSET / mBRSET fundus photographs. The PhysioNet
# DUA forbids redistributing images, so these stay on the cluster. Regenerate
# with: python scripts/58_degradation_figure.py
results/degradation_examples*.png

# The status deck embeds the degradation figure above, so the built file carries
# patient images even though its build script does not. Rebuild locally with:
# python presentation/build_status.py
presentation/BRSET_mBRSET_Status.pptx

# Per-image mBRSET filenames with quality statistics, used for the abstention
# analysis. Aggregate conclusion is in report/RESEARCH_PLAN.md; the filename
# column is a per-patient identifier list and does not belong in the repo.
results/mbrset_test_quality.csv
# Step-4 galleries contain source dataset images and remain local.
research/codex/step4/private/
research/codex/step4/runs
research/codex/step4/smoke
